# Copy to .env for local development. NEVER commit a real .env file.
# In production, set these as environment variables in your hosting provider.

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string. Local default matches docker-compose.yml and
# scripts/local-postgres.mjs. Production: use your managed provider's URL with
# TLS, e.g. ...?sslmode=require
DATABASE_URL="postgresql://exhibition:exhibition_dev_password@localhost:5432/exhibition?schema=public"

# Direct (non-pooled) connection used only by `prisma migrate`. Locally this is
# the same as DATABASE_URL. On Neon: DATABASE_URL = pooled URL (host contains
# "-pooler") with &pgbouncer=true&connect_timeout=15 ; DIRECT_URL = direct URL.
DIRECT_URL="postgresql://exhibition:exhibition_dev_password@localhost:5432/exhibition?schema=public"

# Separate database used by `npm test`. Tests TRUNCATE tables, so the URL must
# contain the word "test" (the test runner refuses otherwise). Never point this
# at production.
TEST_DATABASE_URL="postgresql://exhibition:exhibition_dev_password@localhost:5432/exhibition_test?schema=public"

# --- Authentication ---------------------------------------------------------------
# Canonical URL of the deployed site (used by NextAuth for callbacks/cookies).
NEXTAUTH_URL="http://localhost:3000"

# Secret for signing administrator session tokens. At least 32 random characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET="replace-with-a-long-random-value"

# Secret used to HMAC visitor session tokens and recovery codes before they are
# stored. At least 32 random characters. Changing it signs out every visitor and
# invalidates every recovery code.
PARTICIPANT_TOKEN_SECRET="replace-with-a-different-long-random-value"

# --- Public URL -------------------------------------------------------------------
# Base URL printed in pioneer QR codes when no value is set in Admin → Settings.
# Must be the final HTTPS production domain before printing posters.
PUBLIC_BASE_URL="http://localhost:3000"

# --- Environment & network --------------------------------------------------------
# "development" | "test" | "production" (default production when NODE_ENV=production).
APP_ENV="development"

# Set to "true" ONLY when the app runs behind a trusted reverse proxy/CDN that
# sets X-Forwarded-For (Vercel, Render, Fly, Nginx...). Used for rate limiting.
TRUST_PROXY="false"

# Optional: extra origins (comma separated) allowed to make state-changing API
# requests, e.g. if the same app is served on two domains.
ALLOWED_ORIGINS=""

# Temporary public preview through a tunnel (e.g. cloudflared): when "true",
# /admin, /api/admin/* and /api/auth/* answer only direct localhost requests
# and return 404 to everything arriving through a tunnel or proxy.
# Leave unset/false on the real production deployment.
ADMIN_LOCAL_ONLY="false"

# --- Development helpers (never set in production) --------------------------------
# Password for the demo administrator created by `npm run db:demo`
# (email admin@demo.invalid). If unset, a random password is printed once.
DEMO_ADMIN_PASSWORD=""
